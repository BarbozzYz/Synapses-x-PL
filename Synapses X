--  LOOP PRINCIPAL
-- ══════════════════════════════════════════
do
    local RenderStepped = RunService.RenderStepped
    local DRAWINGS_EMPTY = true
    local StretchChanged = false
    local BaseFOV = nil

    RenderStepped:Connect(function(dt)
        local strokeOn = Config.ESP.StrokeEnabled
        local strokeThick = Config.ESP.StrokeThickness

        if Config.Screen.StretchEnabled then
            if not BaseFOV then BaseFOV = Camera.FieldOfView end
            local target = BaseFOV / math.max(Config.Screen.StretchAmount, 0.1)
            if math.abs(Camera.FieldOfView - target) > 0.01 then Camera.FieldOfView = target end
            StretchChanged = true
        elseif StretchChanged and BaseFOV then
            Camera.FieldOfView = BaseFOV
            StretchChanged = false
            BaseFOV = nil
        end

        if Config.ESP.Enabled then UpdateBlur() end

        if UpdateHighlight then UpdateHighlight() end

        UpdateFOV()
        if Config.Bloom.Enabled then updateBloom() end
        if Config.Atmosphere.Enabled then updateAtmosphere() end
        if Config.SunRays.Enabled then updateSunRays() end
        if Config.Sky.Enabled then updateSky() end
        if Config.LocalPlayer.Enabled then updateLocalPlayer() end
        if Config.LocalPlayer.HideAccessories or Config.LocalPlayer.HideHair then updateAccessories() end
        if Config.Tool.Enabled or Config.Tool.MaterialOverride then updateTools() end
        if Config.Ambient.Enabled then updateAmbient() end
        if Config.AmbientPhysics.SnowEnabled then ap_updateSnow(dt) end
        if Config.AmbientPhysics.LinesEnabled then ap_updateLines(dt) end
        if Config.Trails.Enabled then updateTrails() end
        updateAuras()

        if AutoFireSettings.Enabled and AF_hasGun() then
            local target = AF_getTargetInFOV()
            if target then
                local char = target.Character
                local partName = AutoFireSettings.TargetPart
                if partName == "Random" then
                    partName = (math.random(1,2) == 1) and "Head" or "HumanoidRootPart"
                end
                local part = char and (char:FindFirstChild(partName) or char:FindFirstChild("Head"))
                if part then
                    AutoFireState.Target = target
                    AutoFireState.TargetPos = part.Position
                    if tick() - AutoFireState.LastFire >= AutoFireSettings.FireDelay then
                        AutoFireState.LastFire = tick()
                        AF_click()
                    end
                else
                    AutoFireState.Target, AutoFireState.TargetPos = nil, nil
                end
            else
                AutoFireState.Target, AutoFireState.TargetPos = nil, nil
            end
        else
            AutoFireState.Target, AutoFireState.TargetPos = nil, nil
        end

        if SilentAimSettings.ShowSilentAimTarget and SilentAimSettings.Enabled then
            local t = getClosestPlayer()
            if t then
                local Root = t.Parent.PrimaryPart or t
                local sp, on = Camera:WorldToViewportPoint(Root.Position)
                mouse_box.Visible = on
                mouse_box.Position = Vector2.new(sp.X, sp.Y)
            elseif mouse_box.Visible then
                mouse_box.Visible = false
                mouse_box.Position = Vector2.new()
            end
        end
        if SilentAimSettings.FOVVisible then
            fov_circle.Visible = true
            fov_circle.Color = SilentAimSettings.FOVColor
            fov_circle.Position = getMousePosition()
        elseif fov_circle.Visible then
            fov_circle.Visible = false
        end

        if not Config.ESP.Enabled then
            if not DRAWINGS_EMPTY then
                for player, d in pairs(Drawings) do HideAll(d, player) end
                DRAWINGS_EMPTY = true
            end
            return
        end
        DRAWINGS_EMPTY = false

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not Drawings[p] then CreateESP(p); CreateFillFrame(p) end
        end

        for player, d in pairs(Drawings) do
            local char = player.Character
            if not char then HideAll(d, player); continue end
            if IsTeammate(player) then HideAll(d, player); continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then HideAll(d, player); continue end
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > Config.ESP.MaxDistance then HideAll(d, player); continue end

            local topPos, botPos = GetBoxBounds(char, Config.ESP.BoxPadding)
            if not topPos or not botPos then HideAll(d, player); continue end
            local topScreen, topOn = Camera:WorldToViewportPoint(topPos)
            local botScreen, botOn = Camera:WorldToViewportPoint(botPos)
            if not topOn or not botOn or topScreen.Z < 0 or botScreen.Z < 0 then HideAll(d, player); continue end
            local height = math.abs(botScreen.Y - topScreen.Y)
            local width  = height * Config.ESP.BoxWidthRatio
            local boxX   = topScreen.X - width / 2
            local boxY   = topScreen.Y

            local boxColor    = GetESPColor(player, Config.ESP.BoxColor)
            local lineColor   = GetESPColor(player, Config.ESP.LineColor)
            local nameColor   = GetESPColor(player, Config.ESP.NameColor)
            local distColor   = GetESPColor(player, Config.ESP.DistColor)
            local skelColor   = GetESPColor(player, Config.ESP.SkeletonColor)
            local healthColor = GetESPColor(player, Config.ESP.HealthColor)

            local fill, grad = FillFrames[player], FillGradients[player]
            if Config.ESP.Box and Config.ESP.BoxFilled and fill then
                if not fill.Parent then CreateFillFrame(player); fill = FillFrames[player]; grad = FillGradients[player] end
                fill.Visible = true
                fill.Position = UDim2.fromOffset(boxX, boxY)
                fill.Size = UDim2.fromOffset(width, height)
                fill.BackgroundTransparency = Config.ESP.BoxFillAlpha
                if Config.ESP.BoxGradient then
                    if Config.ESP.TeamColorMode and player.Team then
                        grad.Color = ColorSequence.new(player.Team.TeamColor.Color)
                    else
                        grad.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Config.ESP.BoxGradColor1),
                            ColorSequenceKeypoint.new(1, Config.ESP.BoxGradColor2),
                        })
                    end
                    grad.Rotation = Config.ESP.BoxGradRot; grad.Enabled = true
                    fill.BackgroundColor3 = Color3.new(1,1,1)
                else grad.Enabled = false; fill.BackgroundColor3 = boxColor end
            elseif fill and fill.Visible then
                fill.Visible = false
            end

            if Config.ESP.Box then
                if strokeOn then
                    d.BoxStroke.Visible = true
                    d.BoxStroke.Thickness = strokeThick
                    d.BoxStroke.Position = Vector2.new(boxX - strokeThick, boxY - strokeThick)
                    d.BoxStroke.Size = Vector2.new(width + strokeThick * 2, height + strokeThick * 2)
                    d.BoxStroke.Color = Config.ESP.StrokeColor
                    d.BoxStroke.Transparency = 0
                else
                    if d.BoxStroke.Visible then d.BoxStroke.Visible = false end
                end
                d.Box.Visible = true
                d.Box.Position = Vector2.new(boxX, boxY)
                d.Box.Size = Vector2.new(width, height)
                d.Box.Color = boxColor
                d.Box.Transparency = 0
            else
                if d.BoxStroke.Visible then d.BoxStroke.Visible = false end
                if d.Box.Visible then d.Box.Visible = false end
            end

            if Config.ESP.Line then
                local vp = Camera.ViewportSize
                local fromX, fromY
                if Config.ESP.LineMode == 'Top' then fromX, fromY = vp.X / 2, 0
                elseif Config.ESP.LineMode == 'Middle' then fromX, fromY = vp.X / 2, vp.Y / 2
                else fromX, fromY = vp.X / 2, vp.Y end
                local boxTopX, boxTopY = boxX + width / 2, boxY
                if strokeOn then
                    d.LineStroke.Visible = true
                    d.LineStroke.Thickness = strokeThick * 3
                    d.LineStroke.From = Vector2.new(fromX, fromY)
                    d.LineStroke.To = Vector2.new(boxTopX, boxTopY)
                    d.LineStroke.Color = Config.ESP.StrokeColor
                    d.LineStroke.Transparency = 0
                else
                    if d.LineStroke.Visible then d.LineStroke.Visible = false end
                end
                d.Line.Visible = true
                d.Line.From = Vector2.new(fromX, fromY)
                d.Line.To = Vector2.new(boxTopX, boxTopY)
                d.Line.Color = lineColor
                d.Line.Transparency = 0

                d.LineVertexStart.Visible = true
                d.LineVertexStart.Position = Vector2.new(fromX, fromY)
                d.LineVertexStart.Radius = 3
                d.LineVertexStart.Color = lineColor
                d.LineVertexStart.Transparency = 0

                d.LineVertexEnd.Visible = true
                d.LineVertexEnd.Position = Vector2.new(boxTopX, boxTopY)
                d.LineVertexEnd.Radius = 3
                d.LineVertexEnd.Color = lineColor
                d.LineVertexEnd.Transparency = 0
            else
                if d.LineStroke.Visible then d.LineStroke.Visible = false end
                if d.Line.Visible then d.Line.Visible = false end
                if d.LineVertexStart.Visible then d.LineVertexStart.Visible = false end
                if d.LineVertexEnd.Visible then d.LineVertexEnd.Visible = false end
            end

            if Config.ESP.Health then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local healthX = boxX - Config.ESP.HealthBarOffset
                local barW    = Config.ESP.HealthBarWidth

                if Config.ESP.HealthType == "Drawing" or Config.ESP.HealthType == "Both" then
                    if strokeOn then
                        d.HealthStroke.Visible = true
                        d.HealthStroke.Thickness = barW + strokeThick * 2
                        d.HealthStroke.From = Vector2.new(healthX, boxY)
                        d.HealthStroke.To = Vector2.new(healthX, boxY + height)
                        d.HealthStroke.Color = Config.ESP.StrokeColor
                        d.HealthStroke.Transparency = 0
                    else
                        if d.HealthStroke.Visible then d.HealthStroke.Visible = false end
                    end
                    d.HealthBg.Visible = true
                    d.HealthBg.Thickness = barW + 1
                    d.HealthBg.From = Vector2.new(healthX, boxY)
                    d.HealthBg.To = Vector2.new(healthX, boxY + height)
                    d.HealthBg.Color = Config.ESP.HealthBgColor
                    d.HealthBg.Transparency = 0

                    d.HealthBar.Visible = true
                    d.HealthBar.Thickness = barW
                    d.HealthBar.From = Vector2.new(healthX, boxY + height * (1 - pct))
                    d.HealthBar.To = Vector2.new(healthX, boxY + height)
                    d.HealthBar.Color = healthColor
                    d.HealthBar.Transparency = 0
                else
                    if d.HealthStroke.Visible then d.HealthStroke.Visible = false end
                    if d.HealthBg.Visible then d.HealthBg.Visible = false end
                    if d.HealthBar.Visible then d.HealthBar.Visible = false end
                end

                if Config.ESP.HealthType == "Frame" or Config.ESP.HealthType == "Both" then
                    local hf = GetHealthFrame(player)
                    hf.Root.Visible = true
                    hf.Bg.Position = UDim2.fromOffset(healthX, boxY)
                    hf.Bg.Size = UDim2.fromOffset(barW, height)
                    hf.Bg.BackgroundColor3 = Config.ESP.HealthBgColor
                    hf.BgStroke.Enabled = Config.ESP.HealthBarOutline
                    hf.BgStroke.Thickness = strokeThick
                    hf.BgStroke.Color = Config.ESP.StrokeColor

                    hf.Bar.Position = UDim2.fromOffset(healthX, boxY + height * (1 - pct))
                    hf.Bar.Size = UDim2.fromOffset(barW, height * pct)
                    hf.Bar.BackgroundColor3 = healthColor
                else
                    local hf = HealthFrames[player]
                    if hf and hf.Root.Visible then hf.Root.Visible = false end
                end
            else
                if d.HealthStroke.Visible then d.HealthStroke.Visible = false end
                if d.HealthBg.Visible then d.HealthBg.Visible = false end
                if d.HealthBar.Visible then d.HealthBar.Visible = false end
                local hf = HealthFrames[player]
                if hf and hf.Root.Visible then hf.Root.Visible = false end
            end

            if Config.ESP.Name then
                local head = char:FindFirstChild("Head")
                local nameScreen, nameOn
                if head then
                    nameScreen, nameOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,1.5,0))
                else
                    nameScreen, nameOn = Camera:WorldToViewportPoint(topPos + Vector3.new(0,0.5,0))
                end
                if nameOn and nameScreen.Z > 0 then
                    d.Name.Visible = true
                    d.Name.Text = player.Name
                    d.Name.Position = Vector2.new(nameScreen.X, nameScreen.Y - 15)
                    d.Name.Color = nameColor
                    d.Name.OutlineColor = Config.ESP.StrokeColor
                    d.Name.Transparency = 0
                elseif d.Name.Visible then
                    d.Name.Visible = false
                end
            elseif d.Name.Visible then
                d.Name.Visible = false
            end

            if Config.ESP.Distance then
                d.Distance.Visible = true
                d.Distance.Text = string.format("%d studs", math.floor(dist))
                d.Distance.Position = Vector2.new(boxX + width / 2, boxY + height + 4)
                d.Distance.Color = distColor
                d.Distance.OutlineColor = Config.ESP.StrokeColor
                d.Distance.Transparency = 0
            elseif d.Distance.Visible then
                d.Distance.Visible = false
            end

            if Config.ESP.Skeleton then
                local bones = (hum.RigType == Enum.HumanoidRigType.R6) and BONE_CONNECTIONS_R6 or BONE_CONNECTIONS_R15
                for i, conn in ipairs(bones) do
                    if not d.Skeleton[i] then
                        local stroke = Drawing.new("Line"); stroke.Thickness = 3; stroke.Color = Color3.new(0,0,0); stroke.Transparency = 1; stroke.Visible = false
                        d.SkeletonStroke[i] = stroke
                        local line = Drawing.new("Line"); line.Thickness = 1; line.Transparency = 1; line.Visible = false
                        d.Skeleton[i] = line
                    end
                    local line, stroke = d.Skeleton[i], d.SkeletonStroke[i]
                    local partA, partB = char:FindFirstChild(conn[1]), char:FindFirstChild(conn[2])
                    if partA and partB then
                        local aScreen, aOn = Camera:WorldToViewportPoint(partA.Position)
                        local bScreen, bOn = Camera:WorldToViewportPoint(partB.Position)
                        if aOn and bOn and aScreen.Z > 0 and bScreen.Z > 0 then
                            local fromV = Vector2.new(aScreen.X, aScreen.Y)
                            local toV = Vector2.new(bScreen.X, bScreen.Y)
                            if Config.ESP.SkeletonStroke and strokeOn then
                                stroke.Visible = true
                                stroke.From = fromV; stroke.To = toV
                                stroke.Color = Config.ESP.StrokeColor
                                stroke.Thickness = 1 + strokeThick * 2
                                stroke.Transparency = 0
                            elseif stroke.Visible then
                                stroke.Visible = false
                            end
                            line.Visible = true
                            line.From = fromV; line.To = toV
                            line.Color = skelColor
                            line.Thickness = 1
                            line.Transparency = 0
                        else
                            if line.Visible then line.Visible = false end
                            if stroke.Visible then stroke.Visible = false end
                        end
                    else
                        if line.Visible then line.Visible = false end
                        if stroke.Visible then stroke.Visible = false end
                    end
                end
                for i = #bones + 1, #d.Skeleton do
                    if d.Skeleton[i].Visible then d.Skeleton[i].Visible = false end
                    if d.SkeletonStroke[i].Visible then d.SkeletonStroke[i].Visible = false end
                end
            else
                for _, line in ipairs(d.Skeleton) do if line.Visible then line.Visible = false end end
                for _, line in ipairs(d.SkeletonStroke) do if line.Visible then line.Visible = false end end
            end
        end
    end)
end

-- ══════════════════════════════════════════
--  HOOKS — Silent Aim
-- ══════════════════════════════════════════
do
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local Method = getnamecallmethod()
        if Method ~= "Raycast" and Method ~= "FindPartOnRay" and Method ~= "findPartOnRay"
           and Method ~= "FindPartOnRayWithWhitelist" and Method ~= "FindPartOnRayWithIgnoreList" then
            return oldNamecall(...)
        end
        if not SilentAimSettings.Enabled then return oldNamecall(...) end
        local Arguments = {...}
        local self = Arguments[1]
        if self ~= workspace or checkcaller() then return oldNamecall(...) end
        if not CalculateChance(SilentAimSettings.HitChance) then return oldNamecall(...) end

        local HitPart = getClosestPlayer()
        if not HitPart then return oldNamecall(...) end

        if Method == "Raycast" then
            if SilentAimSettings.SilentAimMethod ~= "Raycast" then return oldNamecall(...) end
            local A_Origin = Arguments[2]
            if typeof(A_Origin) ~= "Vector3" then return oldNamecall(...) end
            Arguments[3] = (HitPart.Position - A_Origin).Unit * 1000
            return oldNamecall(unpack(Arguments))
        elseif Method == "FindPartOnRayWithIgnoreList" then
            if SilentAimSettings.SilentAimMethod ~= Method then return oldNamecall(...) end
            local A_Ray = Arguments[2]
            if typeof(A_Ray) ~= "Ray" then return oldNamecall(...) end
            Arguments[2] = Ray.new(A_Ray.Origin, (HitPart.Position - A_Ray.Origin).Unit * 1000)
            return oldNamecall(unpack(Arguments))
        elseif Method == "FindPartOnRayWithWhitelist" then
            if SilentAimSettings.SilentAimMethod ~= Method then return oldNamecall(...) end
            local A_Ray = Arguments[2]
            if typeof(A_Ray) ~= "Ray" then return oldNamecall(...) end
            Arguments[2] = Ray.new(A_Ray.Origin, (HitPart.Position - A_Ray.Origin).Unit * 1000)
            return oldNamecall(unpack(Arguments))
        elseif Method == "FindPartOnRay" or Method == "findPartOnRay" then
            if SilentAimSettings.SilentAimMethod ~= "FindPartOnRay" then return oldNamecall(...) end
            local A_Ray = Arguments[2]
            if typeof(A_Ray) ~= "Ray" then return oldNamecall(...) end
            Arguments[2] = Ray.new(A_Ray.Origin, (HitPart.Position - A_Ray.Origin).Unit * 1000)
            return oldNamecall(unpack(Arguments))
        end
        return oldNamecall(...)
    end))

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
        if self == Mouse and not checkcaller() and SilentAimSettings.Enabled and SilentAimSettings.SilentAimMethod == "Mouse.Hit/Target" then
            local HitPart = getClosestPlayer()
            if HitPart then
                if Index == "Target" or Index == "target" then return HitPart
                elseif Index == "Hit" or Index == "hit" then
                    return ((SilentAimSettings.MouseHitPrediction and (HitPart.CFrame + (HitPart.Velocity * PredictionAmount))) or HitPart.CFrame)
                elseif Index == "X" or Index == "x" then return self.X
                elseif Index == "Y" or Index == "y" then return self.Y
                elseif Index == "UnitRay" then return Ray.new(self.Origin, (self.Hit - self.Origin).Unit) end
            end
        end
        return oldIndex(self, Index)
    end))
end

