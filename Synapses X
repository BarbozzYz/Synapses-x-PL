            end
        else
            if FovFillFrame and FovFillFrame.Visible then FovFillFrame.Visible = false end
        end
        FovFrame.Visible = true
        FovFrame.Size = UDim2.fromOffset(fov.Radius * 2, fov.Radius * 2)
        FovFrame.Position = UDim2.fromOffset(pos.X, pos.Y)
        FovStroke.Thickness = 1
        FovStroke.Color = fov.Color
        FovStroke.Transparency = 0
    end

    UpdateHighlight = function()
