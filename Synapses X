-- ══════════════════════════════════════════
--  FX ENGINE
-- ══════════════════════════════════════════
do
    local TRAIL_IDS = {
        Trail1 = 139425982705199,
        Trail2 = 83212217754079,
        Trail3 = 100470054533753,
    }
    local AssetCache = {}
    local function loadAsset(id)
        if AssetCache[id] then return AssetCache[id] end
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if ok and objs and #objs > 0 then AssetCache[id] = objs; return objs end
        return nil
    end
    local Effects = {}
    local function getTorso(char) return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") end
    local function floorY(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp then return -3 end
        if hum and hum.RigType == Enum.HumanoidRigType.R6 then return -3 end
        return -(hrp.Size.Y / 2 + (hum and hum.HipHeight or 2))
    end
    local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local rayFilter = {}
    local function groundPos(char, hrp, followInAir)
        if followInAir then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.FloorMaterial == Enum.Material.Air then
                return hrp.Position + Vector3.new(0, floorY(char), 0)
            end
        end
        rayFilter[1] = char
        rayParams.FilterDescendantsInstances = rayFilter
        local res = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), rayParams)
        if res then return res.Position end
        return hrp.Position + Vector3.new(0, floorY(char), 0)
    end
    local function resetFx(fx)
        fx.folder, fx.holder, fx.weld, fx.target, fx.lastColor, fx.lastGlow = nil, nil, nil, nil, nil, nil
        fx.emitters, fx.colorables, fx.parts, fx.glowOrig = {}, {}, {}, {}
    end
    local function destroyEffect(fx)
        if fx.folder then pcall(function() fx.folder:Destroy() end) end
        resetFx(fx)
    end
    local function buildEffect(fx, char, target)
        local assets = loadAsset(fx.id); if not assets then return end
        if not fx.enabled() or LocalPlayer.Character ~= char or not target.Parent then return end
        local folder = Instance.new("Folder"); folder.Name = "FX_" .. fx.name
        local holder = Instance.new("Part")
        holder.Name = "Holder"; holder.Size = Vector3.new(0.2,0.2,0.2); holder.Transparency = 1
        holder.Anchored = false; holder.CanCollide = false; holder.CanTouch = false; holder.CanQuery = false; holder.Massless = true
        local weld
        if fx.world then
            holder.Anchored = true; holder.CFrame = fx.getWorldCF(char, target); holder.Parent = folder
        else
            holder.CFrame = target.CFrame * fx.getCF(char, target); holder.Parent = folder
            weld = Instance.new("Weld"); weld.Name = "FXWeld"; weld.Part0 = target; weld.Part1 = holder
            weld.C0 = fx.getCF(char, target); weld.Parent = holder
        end
        local all = {}
        for _, a in ipairs(assets) do
            local c = a:Clone(); c.Parent = folder; table.insert(all, c)
            for _, d in ipairs(c:GetDescendants()) do table.insert(all, d) end
        end
        local parts = {}
        for _, o in ipairs(all) do if o:IsA("BasePart") then table.insert(parts, o) end end
        local base = parts[1]; local rels = {}
        for _, p in ipairs(parts) do rels[p] = base.CFrame:ToObjectSpace(p.CFrame) end
        for _, o in ipairs(all) do if o:IsA("JointInstance") or o:IsA("WeldConstraint") then o:Destroy() end end
        for _, p in ipairs(parts) do
            p.Anchored = false; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.Massless = true
            local w = Instance.new("Weld"); w.Part0 = holder; w.Part1 = p; w.C0 = rels[p]; w.Parent = p
        end
        local function orphan(o)
            local par = o.Parent
            return not (par and (par:IsA("BasePart") or par:IsA("Attachment")))
        end
        local emitters, colorables = {}, {}
        for _, o in ipairs(all) do
            if o:IsA("Attachment") then
                if not (o.Parent and o.Parent:IsA("BasePart")) then o.Parent = holder end
            elseif o:IsA("ParticleEmitter") then
                o.LockedToPart = fx.locked; table.insert(emitters, o); if orphan(o) then o.Parent = holder end
            elseif o:IsA("Trail") or o:IsA("Beam") then
                table.insert(colorables, o); if orphan(o) then o.Parent = holder end
            elseif o:IsA("Light") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") then
                if orphan(o) then o.Parent = holder end
            end
        end
        fx.folder, fx.holder, fx.weld, fx.target = folder, holder, weld, target
        fx.emitters, fx.colorables, fx.parts = emitters, colorables, parts
        fx.lastColor, fx.lastGlow = nil, nil
        local glowOrig = {}
        for _, list in ipairs({ emitters, colorables }) do
            for _, o in ipairs(list) do pcall(function() glowOrig[o] = { o.LightEmission, o.Brightness } end) end
        end
        fx.glowOrig = glowOrig
        if fx.onBuilt then fx.onBuilt(fx) end
        folder.Parent = char
    end
    local function applyColor(fx, color)
        local seq = ColorSequence.new(color)
        for _, e in ipairs(fx.emitters) do e.Color = seq end
        for _, t in ipairs(fx.colorables) do t.Color = seq end
        if fx.colorParts then for _, p in ipairs(fx.parts) do p.Color = color end end
    end
    local function applyGlow(fx, g)
        for obj, o in pairs(fx.glowOrig) do
            if obj.Parent then
                pcall(function()
                    obj.LightEmission = math.clamp(o[1] + g / 100, 0, 1)
                    obj.Brightness = o[2] * (1 + g / 25)
                end)
            end
        end
    end
    local function updateEffect(fx)
        local enabled = fx.enabled()
        if not enabled and not fx.folder then return end
        local char = LocalPlayer.Character
        if not char or not enabled then if fx.folder then destroyEffect(fx) end; return end
        local target = fx.getTarget(char)
        if not target or not target.Parent then if fx.folder then destroyEffect(fx) end; return end
        if fx.folder and (fx.target ~= target or not fx.folder:IsDescendantOf(char)) then destroyEffect(fx) end
        if not fx.folder then
            if fx.loading or tick() < fx.retryAt then return end
            fx.loading = true
            task.spawn(function()
                local ok, err = pcall(buildEffect, fx, char, target)
                if not ok then warn("[FX] " .. fx.name .. ": " .. tostring(err)) end
                fx.loading = false
                if not fx.folder then fx.retryAt = tick() + 3 end
            end)
            return
        end
        if fx.world then fx.holder.CFrame = fx.getWorldCF(char, target)
        else fx.weld.C0 = fx.getCF(char, target) end
        local color = fx.getColor()
        if fx.lastColor ~= color then fx.lastColor = color; applyColor(fx, color) end
        local glow = Config.Glow[fx.name] or 0
        if fx.lastGlow ~= glow then fx.lastGlow = glow; applyGlow(fx, glow) end
        if fx.onFrame then fx.onFrame(fx, char) end
    end
    local function newFx(name, id, o)
        local fx = { name = name, id = id, retryAt = 0, loading = false, locked = true, emitters = {}, colorables = {}, parts = {}, glowOrig = {} }
        for k, v in pairs(o) do fx[k] = v end
        Effects[name] = fx
        return fx
    end
    local function rotCF(v) return CFrame.Angles(math.rad(v.X), math.rad(v.Y), math.rad(v.Z)) end

    local TrailFx = newFx("Trail", TRAIL_IDS.Trail1, {
        colorParts = false, locked = false,
        enabled = function() return Config.Trails.Enabled end,
        getTarget = getTorso,
        getCF = function() return CFrame.new(Config.Trails.OffsetPos) * rotCF(Config.Trails.OffsetRot) end,
        getColor = function() return Config.Trails.Color end,
    })
    newFx("Ground", 105223044742014, { colorParts = true, enabled = function() return Config.Auras.GroundEnabled end,
        getTarget = function(c) return c:FindFirstChild("HumanoidRootPart") end, world = true,
        getWorldCF = function(c, hrp) local o = Config.Auras.GroundOffset; return CFrame.new(groundPos(c, hrp, true) + Vector3.new(o.X, o.Y, o.Z)) end,
