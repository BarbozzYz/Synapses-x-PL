    local function FindPart(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then return obj end
        if obj:IsA("Model") then
            return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        end
        if obj:IsA("Tool") then
            return obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Handle")
        end
        return obj:FindFirstChildWhichIsA("BasePart")
    end

    local function FindTouchGiverByToolName(toolName)
        for _, c in ipairs(workspace:GetDescendants()) do
            if c.Name == "TouchGiver" then
                local ok, val = pcall(function() return c:GetAttribute("ToolName") end)
                if ok and val == toolName then
                    return c
                end
            end
        end
        return nil
    end

    local TouchGiverCache = {}

    local function GetWeaponTouchGiver(name)
        if TouchGiverCache[name] and TouchGiverCache[name].Parent then
            return TouchGiverCache[name]
        end
        local obj = FindTouchGiverByToolName(name)
        if obj then
            TouchGiverCache[name] = obj
            return obj
        end
        local g = workspace:FindFirstChild("Prison_ITEMS")
        g = g and g:FindFirstChild("giver")
        if g then
            local alt = g:FindFirstChild(name)
            if alt then
                TouchGiverCache[name] = alt
                return alt
            end
        end
        return nil
    end

