local function DrawHitMarker(worldPos)
    if not HitESPConfig.Enabled then return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen or screenPos.Z < 0 then return end

    local size  = HitESPConfig.Size
    local thick = HitESPConfig.Thickness
    local col   = HitESPConfig.Color
    local dur   = HitESPConfig.Duration
    local rot   = HitESPConfig.Rotation or 25
    local gap   = size * 0.35
    local len   = size * 0.5

    -- dois traços perpendiculares formando um +
    local segments = {
        { 0 },   -- horizontal
        { 90 },  -- vertical
    }

    for _, seg in ipairs(segments) do
        local line = Instance.new("Frame")
        line.Name = "HitMarker"
        line.BackgroundColor3 = col
        line.BorderSizePixel = 0
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.ZIndex = 10
        line.Size = UDim2.fromOffset(len, thick)
        line.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
        line.Rotation = seg[1] + rot
        line.Parent = GetHitESPLayer()

        task.spawn(function()
            task.wait(dur)
            line:Destroy()
        end)
    end
end

