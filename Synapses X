--  WALLBANG VEHICLES
-- ══════════════════════════════════════════
do
    local WBV_Saved = setmetatable({}, { __mode = 'k' })
    local WBV_Loop = nil
    local function isInsideWheels(obj, root)
        local parent = obj.Parent
        while parent and parent ~= root do
            if parent:IsA("Model") and parent.Name == "Wheels" then return true end
            parent = parent.Parent
        end
        return false
    end
    local function disablePart(part, root)
        if not part:IsA("BasePart") then return end
        if isInsideWheels(part, root) then return end
        if not WBV_Saved[part] then
            WBV_Saved[part] = { CanCollide = part.CanCollide, CanTouch = part.CanTouch, CanQuery = part.CanQuery }
        end
        if part.CanCollide then part.CanCollide = false end
        if part.CanTouch then part.CanTouch = false end
        if part.CanQuery then part.CanQuery = false end
    end
    local function processAll(root)
        if not root then return end
        disablePart(root, root)
        for _, obj in ipairs(root:GetDescendants()) do disablePart(obj, root) end
    end
    WBV_apply = function()
        local cc = workspace:FindFirstChild("CarContainer")
        if cc then processAll(cc) end
    end
    WBV_stop = function()
        WallbangVehiclesSettings.Enabled = false
        for part, props in pairs(WBV_Saved) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = props.CanCollide
                    part.CanTouch = props.CanTouch
                    part.CanQuery = props.CanQuery
                end)
            end
            WBV_Saved[part] = nil
        end
    end
    WBV_start = function()
        WBV_apply()
        if WBV_Loop then task.cancel(WBV_Loop) end
        WBV_Loop = task.spawn(function()
            while WallbangVehiclesSettings.Enabled do
                task.wait(0.25)
                local cc = workspace:FindFirstChild("CarContainer")
                if cc then processAll(cc) end
            end
        end)
    end
end

