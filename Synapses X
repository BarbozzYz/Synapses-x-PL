do
    local AMBIENT_ASSET = 110575527967231
    local AmbientImage = "rbxassetid://" .. AMBIENT_ASSET
    task.spawn(function()
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. AMBIENT_ASSET) end)
        if ok and objs and objs[1] then
            local o = objs[1]
            if o:IsA("Decal") or o:IsA("Texture") then AmbientImage = o.Texture
            elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then AmbientImage = o.Image end
        end
    end)
    local AmbientDrawings = {}
    local function removeAmbient(player)
        local d = AmbientDrawings[player]; if not d then return end
        pcall(function() d.Image:Destroy() end); AmbientDrawings[player] = nil
    end
    local function getAmbient(player)
        local d = AmbientDrawings[player]
        if d and d.Image.Parent then return d end
        if d then removeAmbient(player) end
        local img = Instance.new("ImageLabel")
        img.Name = "ESP_Ambient_" .. player.Name; img.BackgroundTransparency = 1; img.BorderSizePixel = 0
        img.AnchorPoint = Vector2.new(0.5, 0.5); img.ZIndex = 1000; img.Visible = false; img.Image = AmbientImage
        img.Parent = GetFillGui()
        d = { Image = img }; AmbientDrawings[player] = d; return d
    end
    updateAmbient = function()
        local c = Config.Ambient
        if not c.Enabled then
            for _, d in pairs(AmbientDrawings) do if d.Image.Visible then d.Image.Visible = false end end
            return
        end
        for player in pairs(AmbientDrawings) do if not player.Parent then removeAmbient(player) end end
        local vp = Camera.ViewportSize; local center = Vector2.new(vp.X / 2, vp.Y / 2)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local d = getAmbient(player); local img = d.Image
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or hum.Health <= 0 or IsTeammate(player) then
                    if img.Visible then img.Visible = false end
                else
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if dist > Config.ESP.MaxDistance or onScreen then
                        if img.Visible then img.Visible = false end
                    else
                        local rel = Camera.CFrame:PointToObjectSpace(hrp.Position)
                        local dir = Vector2.new(rel.X, -rel.Y)
                        if dir.Magnitude < 1e-3 then dir = Vector2.new(0, -1) end
                        dir = dir.Unit
                        local pos = center + dir * c.Range
                        if img.Image ~= AmbientImage then img.Image = AmbientImage end
                        img.Size = UDim2.fromOffset(c.Size * 2, c.Size * 2)
                        img.Position = UDim2.fromOffset(pos.X, pos.Y)
                        img.Rotation = math.deg(math.atan2(dir.X, -dir.Y)) + c.RotOffset
                        img.ImageColor3 = GetESPColor(player, c.Color)
                        img.Visible = true
                    end
                end
            end
        end
    end
end

-- ══════════════════════════════════════════
--  AMBIENT PHYSICS
-- ══════════════════════════════════════════
do
    local MAX_SNOW = 300
    local MAX_NODES = 120
    local MAX_LINES = MAX_NODES * (MAX_NODES - 1) / 2
    local AP_SnowFlakes = {}
    local AP_SnowDrawings = {}
    local AP_Nodes = {}
    local AP_LineDrawings = {}
    local AP_NodeDots = {}

    local function ap_vp() return Camera.ViewportSize end
    local function ap_makeFlake(vp)
        return { x = math.random(0, vp.X), y = math.random(-vp.Y, 0), vx = (math.random() - 0.5) * 0.4, vy = 0.4 + math.random() * 0.6 }
    end

    for i = 1, MAX_SNOW do
        local d = Drawing.new("Circle"); d.Filled = true; d.NumSides = 12; d.Radius = 3; d.Transparency = 1; d.Visible = false
        AP_SnowDrawings[i] = d
    end
    for i = 1, MAX_NODES do
        local d = Drawing.new("Circle"); d.Filled = true; d.NumSides = 16; d.Radius = 3; d.Transparency = 1; d.Visible = false
        AP_NodeDots[i] = d
    end
    for i = 1, MAX_LINES do
        local d = Drawing.new("Line"); d.Thickness = 1; d.Transparency = 1; d.Visible = false
        AP_LineDrawings[i] = d
    end

    local function ap_syncSnowCount(vp)
        local c = Config.AmbientPhysics
        local want = c.SnowEnabled and math.min(c.SnowCount, MAX_SNOW) or 0
        while #AP_SnowFlakes < want do table.insert(AP_SnowFlakes, ap_makeFlake(vp)) end
        while #AP_SnowFlakes > want do table.remove(AP_SnowFlakes) end
    end

    ap_updateSnow = function(dt)
        local c = Config.AmbientPhysics; local vp = ap_vp()
        if not c.SnowEnabled then
            for i = 1, #AP_SnowDrawings do
                local d = AP_SnowDrawings[i]
                if d.Visible then d.Visible = false end
            end
            return
        end
        ap_syncSnowCount(vp)
        local speed, baseSize, col = c.SnowSpeed, c.SnowSize, c.SnowColor
        local n = #AP_SnowFlakes
        for i = 1, n do
            local f = AP_SnowFlakes[i]
            f.x = f.x + f.vx * speed * dt * 60
            f.y = f.y + f.vy * speed * dt * 60
            if f.y > vp.Y + 10 then local nf = ap_makeFlake(vp); nf.y = -10; AP_SnowFlakes[i] = nf; f = nf end
            if f.x < -10 then f.x = vp.X + 10 elseif f.x > vp.X + 10 then f.x = -10 end
            local d = AP_SnowDrawings[i]
            if d then
                d.Radius = baseSize; d.Position = Vector2.new(f.x, f.y); d.Color = col; d.Transparency = 0
                if not d.Visible then d.Visible = true end
            end
        end
        for i = n + 1, #AP_SnowDrawings do
            local d = AP_SnowDrawings[i]
            if d.Visible then d.Visible = false end
        end
    end

    local FADE_IN, FADE_OUT = 0.6, 0.8
    local function ap_makeNode(vp)
        local spd = math.random() * 0.5 + 0.15; local ang = math.random() * math.pi * 2
        return { x = math.random(20, math.max(21, vp.X - 20)), y = math.random(20, math.max(21, vp.Y - 20)),
                 vx = math.cos(ang) * spd, vy = math.sin(ang) * spd, life = math.random(400, 1000) / 100, age = 0, alpha = 0 }
    end
    local function ap_syncNodes(vp)
        local c = Config.AmbientPhysics
        local want = c.LinesEnabled and math.min(c.LinesMaxNodes, MAX_NODES) or 0
        while #AP_Nodes < want do table.insert(AP_Nodes, ap_makeNode(vp)) end
        while #AP_Nodes > want do table.remove(AP_Nodes) end
    end
    local function ap_nodeFade(node)
        if node.age < FADE_IN then return node.age / FADE_IN end
        local rem = node.life - node.age
        if rem < FADE_OUT then return math.max(0, rem / FADE_OUT) end
        return 1
    end
    ap_updateLines = function(dt)
        local c = Config.AmbientPhysics; local vp = ap_vp()
        if not c.LinesEnabled then
            for i = 1, #AP_LineDrawings do
                local d = AP_LineDrawings[i]
                if d.Visible then d.Visible = false end
            end
            for i = 1, #AP_NodeDots do
                local d = AP_NodeDots[i]
                if d.Visible then d.Visible = false end
            end
            return
        end
        ap_syncNodes(vp)
        local speed, maxDist, col = c.LinesSpeed, c.LinesMaxDist, c.LinesColor
        local n = #AP_Nodes
        for i = 1, n do
            local node = AP_Nodes[i]
            node.x = node.x + node.vx * speed * dt * 60
            node.y = node.y + node.vy * speed * dt * 60
            node.age = node.age + dt
            if node.x < 0 then node.x = 0; node.vx = math.abs(node.vx)
            elseif node.x > vp.X then node.x = vp.X; node.vx = -math.abs(node.vx) end
            if node.y < 0 then node.y = 0; node.vy = math.abs(node.vy)
            elseif node.y > vp.Y then node.y = vp.Y; node.vy = -math.abs(node.vy) end
            if node.age >= node.life then local nw = ap_makeNode(vp); AP_Nodes[i] = nw; node = nw end
        end
        for i = 1, n do
            local node, dot, fade = AP_Nodes[i], AP_NodeDots[i], ap_nodeFade(AP_Nodes[i])
            if fade > 0.01 then
                dot.Position = Vector2.new(node.x, node.y); dot.Radius = 3; dot.Color = col; dot.Transparency = 1 - fade * 0.9
                if not dot.Visible then dot.Visible = true end
            else
                if dot.Visible then dot.Visible = false end
            end
        end
        for i = n + 1, #AP_NodeDots do
            local dot = AP_NodeDots[i]
            if dot.Visible then dot.Visible = false end
        end
        local lineIdx = 0
        for i = 1, n do
            local a, fa = AP_Nodes[i], ap_nodeFade(AP_Nodes[i])
            for j = i + 1, n do
                local b, fb = AP_Nodes[j], ap_nodeFade(AP_Nodes[j])
                local dx, dy = b.x - a.x, b.y - a.y
                local dist = math.sqrt(dx*dx + dy*dy)
                if dist < maxDist then
                    lineIdx = lineIdx + 1
                    local line = AP_LineDrawings[lineIdx]
                    local alpha = (1 - dist / maxDist) * math.min(fa, fb)
                    if line and alpha > 0.01 then
                        line.From = Vector2.new(a.x, a.y); line.To = Vector2.new(b.x, b.y)
                        line.Color = col; line.Transparency = 1 - alpha * 0.85
                        if not line.Visible then line.Visible = true end
                    elseif line then
                        if line.Visible then line.Visible = false end
                    end
                end
            end
        end
        for i = lineIdx + 1, #AP_LineDrawings do
            local line = AP_LineDrawings[i]
            if line.Visible then line.Visible = false end
        end
    end
end

