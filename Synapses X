        if not cfg.Enabled then
            for p, h in pairs(HL_Active) do
                if h and h.Parent then h:Destroy() end
                HL_Active[p] = nil
            end
            return
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                local ok = char and hum and hum.Health > 0

                if not ok then
                    local h = HL_Active[player]
                    if h and h.Parent then h:Destroy() end
                    HL_Active[player] = nil
                else
                    local h = HL_Active[player]
                    if not h or not h.Parent or h.Parent ~= char then
                        if h and h.Parent then h:Destroy() end
                        h = Instance.new("Highlight")
                        h.Name = "ESP_HL_" .. player.Name
                        h.Adornee = char
                        h.Parent = char
                        HL_Active[player] = h
                    end
                    h.Adornee = char

                    local fill, outline = cfg.FillColor, cfg.OutlineColor
                    if Config.ESP.TeamCheck and player.Team then
                        fill = player.Team.TeamColor.Color
                        outline = player.Team.TeamColor.Color
                    elseif cfg.TeamColorMode and player.Team then
                        fill = player.Team.TeamColor.Color
                        outline = player.Team.TeamColor.Color
