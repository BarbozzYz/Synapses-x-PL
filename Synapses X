                    h.FillColor = fill
                    h.OutlineColor = outline
                    h.FillTransparency = cfg.FillTransparency
                    h.OutlineTransparency = cfg.OutlineTransparency
                    h.DepthMode = (cfg.DepthMode == "Occluded")
                        and Enum.HighlightDepthMode.Occluded
                        or Enum.HighlightDepthMode.AlwaysOnTop
                end
            end
        end

        for p, h in pairs(HL_Active) do
            if not p.Parent or not p.Character or p.Character.Parent == nil then
                if h and h.Parent then h:Destroy() end
                HL_Active[p] = nil
            end
        end
    end
