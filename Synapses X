--  SILENT AIM HELPERS
-- ══════════════════════════════════════════
do
    local GetPlayers = Players.GetPlayers
    local WorldToScreen = Camera.WorldToScreenPoint
    local GetPartsObscuringTarget = Camera.GetPartsObscuringTarget
    local FindFirstChild = game.FindFirstChild
    local GetMouseLocation = UIS.GetMouseLocation

    local ValidTargetParts = {"Head", "HumanoidRootPart"}
    PredictionAmount = 0.165

    CalculateChance = function(Percentage)
        Percentage = math.floor(Percentage)
        local chance = math.floor(Random.new().NextNumber(Random.new(), 0, 1) * 100) / 100
        return chance <= Percentage / 100
    end

    local function getPositionOnScreen(Vector)
        local Vec3, OnScreen = WorldToScreen(Camera, Vector)
        return Vector2.new(Vec3.X, Vec3.Y), OnScreen
    end

    getMousePosition = function() return GetMouseLocation(UIS) end

    IsPlayerVisible = function(Player)
        local PC = Player.Character; local LPC = LocalPlayer.Character
        if not (PC or LPC) then return false end
        local PR = FindFirstChild(PC, SilentAimSettings.TargetPart) or FindFirstChild(PC, "HumanoidRootPart")
        if not PR then return false end
        local Cast, Ign = {PR.Position, LPC, PC}, {LPC, PC}
        local Obs = #GetPartsObscuringTarget(Camera, Cast, Ign)
        return (Obs == 0)
    end

    getFovCenter = function()
        if Config.FOV.OnMouse then
            local m = GetMouseLocation(UIS)
            return Vector2.new(m.X, m.Y)
        end
        local vp = Camera.ViewportSize
        return Vector2.new(vp.X / 2, vp.Y / 2)
    end

    local cachedTarget, cachedAt = nil, 0
    local CACHE_TTL = 0.03

    getClosestPlayer = function()
        local now = tick()
        if now - cachedAt < CACHE_TTL then return cachedTarget end
        cachedAt = now
        if not SilentAimSettings.TargetPart then cachedTarget = nil; return nil end
        local center = getFovCenter()
        local acquireRadius = (Config.FOV.Enabled and Config.FOV.Radius) or SilentAimSettings.FOVRadius or 2000
        local Closest, DistToCenter
        for _, P in next, GetPlayers(Players) do
            if P == LocalPlayer then continue end
            if SilentAimSettings.TeamCheck and P.Team == LocalPlayer.Team then continue end
            local C = P.Character; if not C then continue end
            if SilentAimSettings.VisibleCheck and not IsPlayerVisible(P) then continue end
            local HRP = FindFirstChild(C, "HumanoidRootPart")
            local H = FindFirstChild(C, "Humanoid")
            if not HRP or not H or H.Health <= 0 then continue end
            local SP, OS = getPositionOnScreen(HRP.Position)
            if not OS then continue end
            local D = (center - SP).Magnitude
            if D <= (DistToCenter or acquireRadius) then
                Closest = ((SilentAimSettings.TargetPart == "Random" and C[ValidTargetParts[math.random(1, #ValidTargetParts)]]) or C[SilentAimSettings.TargetPart])
                DistToCenter = D
            end
        end
        cachedTarget = Closest
        return Closest
    end
end

