--  EXPLOITS
-- ══════════════════════════════════════════
do
    local EX_Saved = { AntiJump = nil, AntiJumpParent = nil }

    RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if Config.Exploits.WalkSpeed.Enabled and hum.WalkSpeed ~= Config.Exploits.WalkSpeed.Value then
            hum.WalkSpeed = Config.Exploits.WalkSpeed.Value
        end
        if Config.Exploits.JumpPower.Enabled then
            if not hum.UseJumpPower then hum.UseJumpPower = true end
            if hum.JumpPower ~= Config.Exploits.JumpPower.Value then hum.JumpPower = Config.Exploits.JumpPower.Value end
        end
    end)

    RunService.Heartbeat:Connect(function()
        if not Config.Exploits.BunnyHop then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.FloorMaterial ~= Enum.Material.Air and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    UIS.JumpRequest:Connect(function()
        if Config.Exploits.InfiniteJump then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    local function EX_restoreAntiJump()
        if EX_Saved.AntiJump and EX_Saved.AntiJumpParent then
            EX_Saved.AntiJump.Parent = EX_Saved.AntiJumpParent
        end
        EX_Saved.AntiJump = nil; EX_Saved.AntiJumpParent = nil
    end

    task.spawn(function()
        while task.wait(0.5) do
            local char = LocalPlayer.Character
            if not char then continue end
            local aj = char:FindFirstChild("AntiJump")
            if Config.Exploits.RemoveAntiJump then
                if aj then
                    if not EX_Saved.AntiJump then
                        EX_Saved.AntiJump = aj; EX_Saved.AntiJumpParent = aj.Parent
                    end
                    aj.Parent = nil
                end
            else
                EX_restoreAntiJump()
            end
        end
    end)

    do
        local NC_Saved = setmetatable({}, { __mode = 'k' })
        local NC_LastRun = 0
        local NC_LastEnabled = false

        local function isFloor(part)
            local n = part.Name
            return string.find(string.lower(n), "floor", 1, true) ~= nil
        end

        local function cacheNC(part)
            if not NC_Saved[part] then
                NC_Saved[part] = { CanCollide = part.CanCollide, CanQuery = part.CanQuery }
            end
        end

        local function applyNoClipTo(part)
            if not part:IsA("BasePart") then return end
            if isFloor(part) then return end
            cacheNC(part)
            if part.CanCollide then part.CanCollide = false end
            if part.CanQuery then part.CanQuery = false end
        end

        local function applyNoClipAll()
            for _, d in ipairs(workspace:GetDescendants()) do
                applyNoClipTo(d)
            end
        end

        local function restoreFromCache()
            for part, props in pairs(NC_Saved) do
                if part and part.Parent then
                    pcall(function()
                        part.CanCollide = props.CanCollide
                        part.CanQuery = props.CanQuery
                    end)
                end
                NC_Saved[part] = nil
            end
        end

        local function restoreAllFromWorkspace()
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("BasePart") and not isFloor(d) then
                    pcall(function()
                        d.CanCollide = true
                        d.CanQuery = true
                    end)
                end
            end
        end

        RunService.Heartbeat:Connect(function()
            local enabled = Config.Exploits.NoClip

            if enabled ~= NC_LastEnabled then
                NC_LastEnabled = enabled
                if not enabled then
                    restoreFromCache()
                    task.spawn(function()
                        task.wait(0.1)
                        restoreAllFromWorkspace()
                    end)
                    return
                end
            end

            if not enabled then return end
            local now = tick()
            if now - NC_LastRun < 0.2 then return end
            NC_LastRun = now
            applyNoClipAll()
            local char = LocalPlayer.Character
            if char then
                for _, d in ipairs(char:GetDescendants()) do applyNoClipTo(d) end
            end
        end)
    end

    do
        local RD_SavedDoor = nil
        local RD_SavedParent = nil

        task.spawn(function()
            while task.wait(0.5) do
                local doors = workspace:FindFirstChild("Doors")
                if Config.Exploits.RemoveDoors then
                    if doors then
                        if not RD_SavedDoor then
                            RD_SavedDoor = doors
                            RD_SavedParent = doors.Parent
                        end
                        doors.Parent = nil
                    end
                else
                    if RD_SavedDoor and RD_SavedParent then
                        RD_SavedDoor.Parent = RD_SavedParent
                        RD_SavedDoor = nil
                        RD_SavedParent = nil
                    end
                end
            end
        end)
    end

    local SP_Accum = 0
    RunService.Heartbeat:Connect(function(dt)
        if not Config.Exploits.SpinBot.Enabled then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        SP_Accum = SP_Accum + math.rad(Config.Exploits.SpinBot.Speed) * dt
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, SP_Accum, 0)
    end)
end

-- ══════════════════════════════════════════
--  VEHICLE FLY
-- ══════════════════════════════════════════
do
    local VF_State = {
        CurrentVehicle = nil, HeartbeatConn = nil, WatcherConn = nil,
        SavedProps = setmetatable({}, { __mode = 'k' }),
        WheelWelds = {}, SavedConstraints = {},
    }
    local function VF_getVehicle()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat then return nil end
        local node = seat
        while node and node ~= workspace do
            if node:IsA("Model") then
                local body = node:FindFirstChild("Body")
                if body then
                    local m = body:FindFirstChild("Main")
                    if m and m:IsA("BasePart") then return { seat = seat, model = node, main = m } end
                end
                local m2 = node:FindFirstChild("Main", true)
                if m2 and m2:IsA("BasePart") then return { seat = seat, model = node, main = m2 } end
            end
            node = node.Parent
        end
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then return { seat = seat, model = model, main = model.PrimaryPart or seat } end
        return nil
    end
    local function VF_cache(part)
        if not VF_State.SavedProps[part] then
            VF_State.SavedProps[part] = { Anchored = part.Anchored, Massless = part.Massless, CanCollide = part.CanCollide }
        end
    end
    local function VF_findWheels(model)
        local w = model:FindFirstChild("Wheels")
        if w then return w end
        local p = model.Parent
        while p and p ~= workspace do
            local w2 = p:FindFirstChild("Wheels")
            if w2 then return w2 end
            p = p.Parent
        end
        return nil
    end
    local function VF_detachWheels(wheels, main)
        if not wheels then return end
        for _, part in ipairs(wheels:GetDescendants()) do
            if part:IsA("BasePart") then
                VF_cache(part)
                for _, c in ipairs(part:GetChildren()) do
                    if c:IsA("WeldConstraint") or c:IsA("HingeConstraint") or c:IsA("Motor6D")
                       or c:IsA("CylindricalConstraint") or c:IsA("BallSocketConstraint")
                       or c:IsA("Weld") or c:IsA("Rotate") or c:IsA("Snap") then
                        VF_State.SavedConstraints[c] = { parent = part }; c.Parent = nil
                    end
                end
                if part.Anchored then part.Anchored = false end
                if not part.Massless then part.Massless = true end
                if part.CanCollide then part.CanCollide = false end
                local w = Instance.new("WeldConstraint")
                w.Name = "VF_WheelWeld"; w.Part0 = main; w.Part1 = part
                w.Parent = part
                VF_State.WheelWelds[w] = true
            end
        end
    end
    local function VF_reattachWheels()
        for w in pairs(VF_State.WheelWelds) do if w and w.Parent then w:Destroy() end end
        VF_State.WheelWelds = {}
        for c, info in pairs(VF_State.SavedConstraints) do
            if c and info.parent and info.parent.Parent then c.Parent = info.parent end
        end
        VF_State.SavedConstraints = {}
    end
    local function VF_freeze(v)
        for _, d in ipairs(v.model:GetDescendants()) do
            if d:IsA("BasePart") then
                VF_cache(d)
                if not d.Massless then d.Massless = true end
            end
        end
        VF_cache(v.main)
        if not v.main.Anchored then v.main.Anchored = true end
    end
    local function VF_unfreeze(v)
        for part, props in pairs(VF_State.SavedProps) do
            if part and part.Parent then
                pcall(function()
                    part.Anchored = props.Anchored
                    part.Massless = props.Massless
                    part.CanCollide = props.CanCollide
                end)
            end
            VF_State.SavedProps[part] = nil
        end
    end
    local function VF_startLoop()
        if VF_State.HeartbeatConn then VF_State.HeartbeatConn:Disconnect() end
        VF_State.HeartbeatConn = RunService.RenderStepped:Connect(function(dt)
            if not Config.Exploits.VehicleFly.Intent then return end
            local v = VF_State.CurrentVehicle
            if not v or not v.model.Parent or not v.main.Parent then return end
            local camCF = Camera.CFrame
            local fwd, right = camCF.LookVector, camCF.RightVector
            local move = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
            if move.Magnitude > 0 then
                v.main.CFrame = v.main.CFrame + move.Unit * Config.Exploits.VehicleFly.Speed * dt
            end
        end)
    end
    local function VF_stopLoop()
        if VF_State.HeartbeatConn then VF_State.HeartbeatConn:Disconnect(); VF_State.HeartbeatConn = nil end
    end
    local function VF_applyToVehicle(v)
        if VF_State.CurrentVehicle then
            VF_reattachWheels()
            VF_unfreeze(VF_State.CurrentVehicle)
        end
        VF_State.CurrentVehicle = v
        VF_freeze(v)
        local w = VF_findWheels(v.model)
        if w then VF_detachWheels(w, v.main) end
        VF_startLoop()
    end
    local function VF_removeFromVehicle(launch)
        VF_stopLoop()
        VF_reattachWheels()
        if VF_State.CurrentVehicle then
            local v = VF_State.CurrentVehicle
            VF_unfreeze(v)
            if launch then
                v.main.Anchored = false
                v.main.AssemblyLinearVelocity = Vector3.new(0, 500, 0)
            end
        end
        VF_State.CurrentVehicle = nil
    end
    local function VF_watcher()
        if VF_State.WatcherConn then VF_State.WatcherConn:Disconnect() end
        local lastSeat = nil
        VF_State.WatcherConn = RunService.Heartbeat:Connect(function()
            local v = VF_getVehicle()
            local seat = v and v.seat or nil
            if seat ~= lastSeat then
                local leftCar = (seat == nil and lastSeat ~= nil)
                lastSeat = seat
                if v then
                    if Config.Exploits.VehicleFly.Intent then
                        task.wait(0.2)
                        VF_applyToVehicle(v)
                    end
                else
                    if VF_State.CurrentVehicle then
                        local launch = leftCar and Config.Exploits.VehicleFly.AutoDeleteCar
                        VF_removeFromVehicle(launch)
                    end
                end
            end
        end)
    end
    VF_watcher()
    VF_toggleIntent = function()
        Config.Exploits.VehicleFly.Intent = not Config.Exploits.VehicleFly.Intent
        if Config.Exploits.VehicleFly.Intent then
            local v = VF_getVehicle()
            if v then VF_applyToVehicle(v) end
        else
            VF_removeFromVehicle(false)
        end
    end
end

