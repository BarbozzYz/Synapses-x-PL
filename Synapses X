do
    TOOL_MATERIALS = { 'Original' }
    for _, n in ipairs(MATERIAL_NAMES) do table.insert(TOOL_MATERIALS, n) end

    local ToolData = {}
    local ToolLast = 0
    local function clearTool(player)
        local d = ToolData[player]; if not d then return end
        if d.hl then pcall(function() d.hl:Destroy() end) end
        for part, m in pairs(d.orig) do if part.Parent then pcall(function() part.Material = m end) end end
        for part, tid in pairs(d.origTex) do if part and part.Parent then pcall(function() part.TextureID = tid end) end end
        ToolData[player] = nil
    end
    local function clearAllTools() for player in pairs(ToolData) do clearTool(player) end end
    updateTools = function()
        local c = Config.Tool
        if not c.Enabled and not c.MaterialOverride then
            if next(ToolData) ~= nil then clearAllTools() end
            return
        end
        local now = tick(); if now - ToolLast < 0.15 then return end; ToolLast = now
        for player in pairs(ToolData) do if not player.Parent then clearTool(player) end end
        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            local modeAllows = (c.Mode == "All" and not IsTeammate(player)) or (c.Mode == "Only Self" and player == LocalPlayer)
            local valid = tool and (modeAllows or c.MaterialOverride)
            if not valid then clearTool(player)
            else
                local d = ToolData[player]
                if d and (d.tool ~= tool) then clearTool(player); d = nil end
                if not d then
                    local hl = nil
                    if c.Enabled and modeAllows then
                        hl = Instance.new("Highlight"); hl.Name = "ESP_ToolChams"; hl.Adornee = tool
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.FillTransparency = 0; hl.OutlineTransparency = 0
                        hl.FillColor = c.Color; hl.OutlineColor = c.Color
                        hl.Parent = tool
                    end
                    d = { tool = tool, hl = hl, orig = setmetatable({}, { __mode = 'k' }), origTex = setmetatable({}, { __mode = 'k' }) }
                    ToolData[player] = d
                end
                if d.hl and d.hl.Parent then
                    if d.hl.FillColor ~= c.Color then d.hl.FillColor = c.Color; d.hl.OutlineColor = c.Color end
                end
                if c.MaterialOverride then
                    local mat = Enum.Material[c.MaterialOverrideValue]
                    if mat then
                        for _, part in ipairs(tool:GetDescendants()) do
                            if part:IsA("BasePart") then
                                if d.orig[part] == nil then d.orig[part] = part.Material end
                                if part.Material ~= mat then pcall(function() part.Material = mat end) end
                                if part:IsA("MeshPart") and part.TextureID ~= "" then
                                    if d.origTex[part] == nil then d.origTex[part] = part.TextureID end
                                    pcall(function() part.TextureID = "" end)
                                end
                            end
                        end
                    end
                else
                    for part, m in pairs(d.orig) do
                        if part.Parent and part.Material ~= m then pcall(function() part.Material = m end) end
                        d.orig[part] = nil
                    end
                    for part, tid in pairs(d.origTex) do
                        if part and part.Parent and part:IsA("MeshPart") and part.TextureID ~= tid then
                            pcall(function() part.TextureID = tid end)
                        end
                        d.origTex[part] = nil
                    end
                end
            end
        end
    end
end

