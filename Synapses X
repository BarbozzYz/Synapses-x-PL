-- ══════════════════════════════════════════
do
    MATERIAL_NAMES = {}
    for _, m in ipairs(Enum.Material:GetEnumItems()) do
        if m ~= Enum.Material.Air and m ~= Enum.Material.Water then table.insert(MATERIAL_NAMES, m.Name) end
    end
    table.sort(MATERIAL_NAMES)

    local function materialSupport(name)
        if name == 'Neon' or name == 'ForceField' then return false, true end
        return true, true
    end
    local LPOriginals = setmetatable({}, { __mode = 'k' })
    local LPLastRun = 0
    local LPClothes = {}
    local HAIR_NAMES  = { Hair=true, Eyebrow=true, Eyelash=true }
    local CLOTH_NAMES = { TShirt=true, Shirt=true, Pants=true, Jacket=true, Sweater=true, Shorts=true, LeftShoe=true, RightShoe=true, DressSkirt=true }
    local function isFxPart(part, char)
        local a = part.Parent
        while a and a ~= char do
            if a.Name:sub(1,3) == 'FX_' then return true end
            a = a.Parent
        end
        return false
    end
    local function restoreLocalPlayer()
        for _, e in ipairs(LPClothes) do pcall(function() if e.parent and e.parent.Parent then e.inst.Parent = e.parent end end) end
        LPClothes = {}
        for part, o in pairs(LPOriginals) do
            if part and part.Parent then
                pcall(function() part.Material = o.Material; part.Color = o.Color; part.Reflectance = o.Reflectance; part.Transparency = o.Transparency end)
            end
            LPOriginals[part] = nil
        end
    end
    updateLocalPlayer = function()
        local c = Config.LocalPlayer
        if not c.Enabled then if next(LPOriginals) ~= nil or #LPClothes > 0 then restoreLocalPlayer() end; return end
        local now = tick(); if now - LPLastRun < 0.25 then return end; LPLastRun = now
        local char = LocalPlayer.Character; if not char then return end
        for _, o in ipairs(char:GetChildren()) do
            if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic")
               or (o:IsA("Accessory") and CLOTH_NAMES[o.AccessoryType.Name]) then
                table.insert(LPClothes, { inst = o, parent = char }); o.Parent = nil
            end
        end
        local mat = Enum.Material[c.Material]; if not mat then return end
        local reflOk, transOk = materialSupport(c.Material)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not isFxPart(part, char) then
                local o = LPOriginals[part]
                if not o then
                    o = { Material = part.Material, Color = part.Color, Reflectance = part.Reflectance, Transparency = part.Transparency }
                    LPOriginals[part] = o
                end
                if part.Material ~= mat then pcall(function() part.Material = mat end) end
                local col = c.CustomColor and c.Color or o.Color
                if part.Color ~= col then part.Color = col end
                local refl = (reflOk and c.Reflectance > 0) and c.Reflectance or o.Reflectance
                if part.Reflectance ~= refl then part.Reflectance = refl end
                local trans = (transOk and c.Transparency > 0) and c.Transparency or o.Transparency
                if part.Transparency ~= trans then part.Transparency = trans end
            end
        end
    end
    local LPAccHidden = {}
    local LPAccLast = 0
    local function restoreAccessories()
        for _, e in ipairs(LPAccHidden) do pcall(function() if e.parent and e.parent.Parent then e.inst.Parent = e.parent end end) end
        LPAccHidden = {}
    end
    updateAccessories = function()
        local c = Config.LocalPlayer
        if not (c.HideAccessories or c.HideHair) then if #LPAccHidden > 0 then restoreAccessories() end; return end
        local now = tick(); if now - LPAccLast < 0.3 then return end; LPAccLast = now
        for i = #LPAccHidden, 1, -1 do
            local e = LPAccHidden[i]
            local wanted = (e.hair and c.HideHair) or (not e.hair and c.HideAccessories)
            if not wanted then
                pcall(function() if e.parent and e.parent.Parent then e.inst.Parent = e.parent end end)
                table.remove(LPAccHidden, i)
            end
        end
        local char = LocalPlayer.Character; if not char then return end
        for _, o in ipairs(char:GetChildren()) do
            if o:IsA("Accessory") then
                local name = o.AccessoryType.Name
                if not CLOTH_NAMES[name] then
                    local isHair = HAIR_NAMES[name] == true
                    if (isHair and c.HideHair) or (not isHair and c.HideAccessories) then
                        table.insert(LPAccHidden, { inst = o, parent = char, hair = isHair }); o.Parent = nil
                    end
                end
            end
        end
    end
end

