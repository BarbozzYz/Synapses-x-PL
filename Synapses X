-- ══════════════════════════════════════════
do
    local BT_GunTracers = require(ReplicatedStorage.SharedModules.GunTracers)
    local function BT_makeTracer(name, origin, target, thickness, color, transparency, lifetime)
        local mag = (origin - target).Magnitude
        local mid = (origin + target) / 2
        local part = Instance.new("Part")
        part.Name = name
        part.Material = Enum.Material.Neon
        part.Anchored = true
        part.Transparency = transparency
        part.FormFactor = Enum.FormFactor.Custom
        part.Size = Vector3.new(thickness, thickness, mag)
        part.CFrame = CFrame.new(mid, target)
        part.CanCollide = false; part.CanQuery = false; part.CanTouch = false
        part.Color = color
        part.BrickColor = BrickColor.new(color)
        part.Parent = Camera
        local tween = TweenService:Create(part, TweenInfo.new(lifetime, Enum.EasingStyle.Linear, Enum.EasingDirection.In), { Transparency = 1 })
        tween:Play()
        Debris:AddItem(part, lifetime + 0.05)
        return part
    end
    local BT_originals = {
        createBullet = BT_GunTracers.createBullet,
        createSniper = BT_GunTracers.createSniper,
        createTaser  = BT_GunTracers.createTaser,
    }
    BT_GunTracers.createBullet = function(origin, target)
        if not Config.BulletTracer.Enabled then return BT_originals.createBullet(origin, target) end
        if not Config.BulletTracer.HideOriginal then BT_originals.createBullet(origin, target) end
        BT_makeTracer("BulletTracer", origin, target,
            Config.BulletTracer.BulletThickness, Config.BulletTracer.BulletColor,
            Config.BulletTracer.BulletTransparency, Config.BulletTracer.BulletLifetime)
    end
    BT_GunTracers.createSniper = function(origin, target)
        if not Config.BulletTracer.Enabled then return BT_originals.createSniper(origin, target) end
        if not Config.BulletTracer.HideOriginal then BT_originals.createSniper(origin, target) end
        BT_makeTracer("SniperTracer", origin, target,
            Config.BulletTracer.SniperThickness, Config.BulletTracer.SniperColor,
            Config.BulletTracer.SniperTransparency, Config.BulletTracer.SniperLifetime)
    end
    BT_GunTracers.createTaser = function(origin, target)
        if not Config.BulletTracer.Enabled then return BT_originals.createTaser(origin, target) end
        if not Config.BulletTracer.HideOriginal then BT_originals.createTaser(origin, target) end
        BT_makeTracer("TaserTracer", origin, target,
            Config.BulletTracer.TaserThickness, Config.BulletTracer.TaserColor,
            Config.BulletTracer.TaserTransparency, Config.BulletTracer.TaserLifetime)
    end

    local BT_prevBullet = BT_GunTracers.createBullet
    local BT_prevSniper = BT_GunTracers.createSniper
    local BT_prevTaser  = BT_GunTracers.createTaser

    local function FindPlayerFromPosition(pos)
        local best, bestDist
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - pos).Magnitude
                    if d < 15 and (not bestDist or d < bestDist) then
                        best, bestDist = p, d
                    end
                end
            end
        end
        return best
    end

        local function IsLocalShot(origin)
        local char = LocalPlayer.Character
        if not char then return false end
        local head = char:FindFirstChild("Head")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local ref = head and head.Position or (hrp and hrp.Position)
        if not ref then return false end
        -- tolerância generosa: 10 studs do origin do player local
        return (origin - ref).Magnitude < 15
    end

    local function ProcessHit(origin, target)
        
        if not IsLocalShot(origin) then return end

        PlayShootSound()
        DrawHitMarker(target)

        local victim = FindPlayerFromPosition(target)
        if victim then
            local char = victim.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                local before = hum.Health
                task.spawn(function()
                    task.wait(0.12)
                    local char2 = victim.Character
                    local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
                    if hum2 and hum2.Health < before then
                        local dmg = math.floor(before - hum2.Health)
                        if dmg > 0 then
                            PlayHitSound()
                            DrawDamageNumber(target, dmg)
                        end
                    end
                end)
            end
        end
    end

    BT_GunTracers.createBullet = function(origin, target)
        local r = BT_prevBullet(origin, target)
        ProcessHit(origin, target)
        return r
    end
    BT_GunTracers.createSniper = function(origin, target)
        local r = BT_prevSniper(origin, target)
        ProcessHit(origin, target)
        return r
    end
    BT_GunTracers.createTaser = function(origin, target)
        local r = BT_prevTaser(origin, target)
        ProcessHit(origin, target)
        return r
    end
end

-- ══════════════════════════════════════════
--  CAR COLOR
-- ══════════════════════════════════════════
do
    local CC_CarContainer = workspace:WaitForChild("CarContainer")
    local CC_Originals = setmetatable({}, { __mode = 'k' })

    local function CC_cache(part)
        if not CC_Originals[part] then
            CC_Originals[part] = { Color = part.Color, Transparency = part.Transparency, Material = part.Material }
        end
    end
    local function CC_isExcluded(part)
        if Config.CarColor.ExcludeSirens and part.Name == "sirens" then return true end
        return false
    end
    local function CC_applyTo(part)
        if not part:IsA("BasePart") then return end
        if CC_isExcluded(part) then return end
        CC_cache(part)
        if part.Color ~= Config.CarColor.Color then part.Color = Config.CarColor.Color end
        local desiredTrans
        if Config.CarColor.Transparency > 0 then
            local base = Config.CarColor.PreserveTransparency and CC_Originals[part].Transparency or 0
            desiredTrans = math.clamp(base + Config.CarColor.Transparency, 0, 1)
        else
            desiredTrans = Config.CarColor.PreserveTransparency and CC_Originals[part].Transparency or 0
        end
        if part.Transparency ~= desiredTrans then part.Transparency = desiredTrans end
        local desiredMat
        if Config.CarColor.Material ~= "Original" then
            desiredMat = Enum.Material[Config.CarColor.Material]
        else
            desiredMat = CC_Originals[part].Material
        end
        if desiredMat and part.Material ~= desiredMat then pcall(function() part.Material = desiredMat end) end
    end
    CC_apply = function()
        for _, model in ipairs(CC_CarContainer:GetChildren()) do
            if model:IsA("Model") then
                for _, part in ipairs(model:GetDescendants()) do CC_applyTo(part) end
            end
        end
    end
    CC_restore = function()
        for part, orig in pairs(CC_Originals) do
            if part and part.Parent then
                part.Color = orig.Color
                part.Transparency = orig.Transparency
                pcall(function() part.Material = orig.Material end)
            end
        end
        CC_Originals = setmetatable({}, { __mode = 'k' })
    end
    CC_CarContainer.ChildAdded:Connect(function(child)
        if child:IsA("Model") then
            task.wait(0.1)
            for _, part in ipairs(child:GetDescendants()) do CC_applyTo(part) end
        end
    end)
end

-- ══════════════════════════════════════════
--  ESP ITEMS
-- ══════════════════════════════════════════
do
    local EI_Tracked = {}
    local EI_EXCLUDE = { Tool = true, Backpack = true, Character = true }
    local function EI_isLooseM9(model)
        if model.Name ~= "M9" then return false end
        local p = model.Parent
        while p and p ~= workspace do
            if EI_EXCLUDE[p.ClassName] then return false end
            if p:IsA("Tool") or p:IsA("Backpack") then return false end
            if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return false end
            p = p.Parent
        end
        return true
    end
    local function EI_shouldTrack(model)
        if not model:IsA("Model") then return false end
        if not Config.ESPItems.Enabled then return false end
        if model.Name == "Key card" then return true end
        if model.Name == "M9" then return EI_isLooseM9(model) end
        return false
    end
    local function EI_createHighlight(model, cfg)
        local hl = Instance.new("Highlight")
        hl.Name = "ESP_ItemHL"; hl.Adornee = model
        hl.FillColor = cfg.Color; hl.OutlineColor = cfg.Color
        hl.FillTransparency = cfg.FillTransparency; hl.OutlineTransparency = cfg.OutlineTransparency
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = model
        return hl
    end
    local function EI_createBillboard(model, cfg)
        local basePart = model.PrimaryPart
        if not basePart then
            for _, c in ipairs(model:GetChildren()) do
                if c:IsA("BasePart") then basePart = c; break end
            end
        end
        if not basePart then return nil end
        local bb = Instance.new("BillboardGui")
        bb.Name = "ESP_ItemLabel"; bb.Adornee = basePart
        bb.Size = UDim2.new(0, 120, 0, 24)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = Config.ESPItems.MaxDistance
        bb.Parent = model
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
        label.Text = cfg.Label; label.TextColor3 = cfg.Color
        label.TextStrokeTransparency = 0; label.TextStrokeColor3 = Color3.new(0,0,0)
        label.Font = Enum.Font.GothamBold; label.TextScaled = true
        label.Parent = bb
        return bb
    end
    local function EI_track(model)
        if EI_Tracked[model] then return end
        local cfg = Config.ESPItems.Items[model.Name]
        local hl = EI_createHighlight(model, cfg)
        local bb = EI_createBillboard(model, cfg)
        EI_Tracked[model] = { highlight = hl, billboard = bb }
    end
    local function EI_untrack(model)
        local e = EI_Tracked[model]
        if not e then return end
        if e.highlight then pcall(function() e.highlight:Destroy() end) end
        if e.billboard then pcall(function() e.billboard:Destroy() end) end
        EI_Tracked[model] = nil
    end
    local function EI_scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if EI_shouldTrack(child) then EI_track(child) end
            if #child:GetChildren() > 0 and not child:IsA("BasePart") then EI_scan(child) end
        end
    end
    EI_scan(workspace)
    task.spawn(function()
        while task.wait(Config.ESPItems.RescanInterval) do
            if Config.ESPItems.Enabled then
                EI_scan(workspace)
                for m in pairs(EI_Tracked) do
                    if not m.Parent or not EI_shouldTrack(m) then EI_untrack(m) end
                end
            else
                for m in pairs(EI_Tracked) do EI_untrack(m) end
            end
        end
    end)
    workspace.DescendantRemoving:Connect(function(inst) if EI_Tracked[inst] then EI_untrack(inst) end end)
    workspace.DescendantAdded:Connect(function(inst)
        if inst:IsA("Model") and Config.ESPItems.Enabled and (inst.Name == "Key card" or inst.Name == "M9") then
            task.wait(0.1)
            if inst.Parent and EI_shouldTrack(inst) then EI_track(inst) end
        end
    end)
end

