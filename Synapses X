do
    local function RF_getEquippedGun()
        local char = LocalPlayer.Character
        if not char then return nil end
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ToolType") == "Gun" then return t end
        end
        return nil
    end
    local RF_originalWait
    RF_originalWait = hookfunction(task.wait, function(duration, ...)
        if RapidFireSettings.Enabled and typeof(duration) == "number" then
            local gun = RF_getEquippedGun()
            if gun then
                local fireRate = gun:GetAttribute("FireRate")
                if fireRate and math.abs(duration - fireRate) < 0.001 then
                    local newWait = math.max(duration / RapidFireSettings.Multiplier, RapidFireSettings.MinWait)
                    return RF_originalWait(newWait, ...)
                end
            end
        end
        return RF_originalWait(duration, ...)
    end)
end

