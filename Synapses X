    local function TP_to_weapon(name)
        local obj = GetWeaponTouchGiver(name)
        if not obj then return false, "nao encontrado" end
        local base = FindPart(obj)
        if not base then return false, "sem BasePart" end

        local char = LocalPlayer.Character
        if not char then return false, "sem char" end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false, "sem HRP" end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false, "sem hum" end

        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait(0.05)

        local pos = base.Position + Vector3.new(0, 3, 0)
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        task.wait(0.1)

        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true, base
    end

