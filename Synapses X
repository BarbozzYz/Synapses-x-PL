local ShootSoundObj = nil
local HitSoundObj = nil

local function GetShootSoundId()
    if SoundConfig.ShootCustomId ~= "" then return SoundConfig.ShootCustomId end
    return SoundPresets.Shoot[SoundConfig.ShootPreset]
end
local function GetHitSoundId()
    if SoundConfig.HitCustomId ~= "" then return SoundConfig.HitCustomId end
    return SoundPresets.Hit[SoundConfig.HitPreset]
end

local function EnsureSound(id, slot)
    if not id or id == "" then return nil end
    local obj = (slot == "shoot") and ShootSoundObj or HitSoundObj
    if not obj or not obj.Parent then
        obj = Instance.new("Sound")
        obj.Name = (slot == "shoot") and "SynShootSound" or "SynHitSound"
        obj.Parent = SoundService
        if slot == "shoot" then ShootSoundObj = obj else HitSoundObj = obj end
    end
    if obj.SoundId ~= id then obj.SoundId = id end
    return obj
end

local function PlayShootSound()
    if not SoundConfig.ShootEnabled then return end
    local s = EnsureSound(GetShootSoundId(), "shoot")
    if s then s:Play() end
end

local function PlayHitSound()
    if not SoundConfig.HitEnabled then return end
    local s = EnsureSound(GetHitSoundId(), "hit")
    if s then s:Play() end
end

